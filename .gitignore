.DS_Store
node_modules/
.vite/
.deprecated/
.scratch/

# renders
out/

# projects: Lyric-Sync caches and song audio (stems) are local. pdoom_original keeps its audio in git.
projects/*/lyricsync/
# scratch projects (projects/_<name>/): experiments, never committed, left out of the typecheck
projects/_*/
projects/*/generated/beat_logits.json
projects/*/user_input/**/*.wav
projects/*/user_input/**/*.mp3
projects/*/user_input/**/*.flac
projects/*/user_input/**/*.ogg
projects/*/user_input/**/*.m4a
projects/*/user_input/**/*.aac
projects/*/user_input/**/*.opus
!projects/pdoom_original/user_input/**
# the static site's audio is a release asset (app/scripts/site-data.ts), not in git
projects/*/site/*.mp3
# sardine: the UTAU sources (ust, aup) and the vocal renders are local. placements.json stays in git.
projects/sardine/user_input/ust/
projects/sardine/user_input/**/*.aup
projects/sardine/generated/renders/
# sardine: the video assets (sprites, timeline.json) are release assets listed in video/assets.json (pve assets), not in git
projects/sardine/video/assets/

# notes & post-mortems
.lessons/
projects/*/video/notes/
